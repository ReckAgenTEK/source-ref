{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://source-ref.dev/schema/source-ref.lock.schema.json",
  "title": "source-ref lock file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositories"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repositories": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/repository"
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "tag",
            "branch",
            "commit"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "mode",
        "requested",
        "resolvedCommit"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "mode": {
          "enum": [
            "pinned",
            "branch"
          ]
        },
        "requested": {
          "$ref": "#/$defs/ref"
        },
        "resolvedCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "branch"
              }
            }
          },
          "then": {
            "properties": {
              "requested": {
                "properties": {
                  "kind": {
                    "const": "branch"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
