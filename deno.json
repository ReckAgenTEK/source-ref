{
  "name": "@mannsion/source-ref",
  "version": "0.1.0-beta.1",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.17",
    "@std/path": "jsr:@std/path@1.1.4"
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "typecheck": "deno check src/mod.ts src/cli.ts",
    "test": "deno test --allow-read --allow-write --allow-run=git tests",
    "check": "deno task fmt:check && deno task lint && deno task typecheck && deno task test"
  },
  "publish": {
    "include": [
      "src",
      "schema",
      "README.md",
      "LICENSE"
    ]
  }
}
